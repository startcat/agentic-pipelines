  "cards": [
    {
      "dot": "cyan",
      "title": "Engine",
      "items": [
        "Contains no real pipeline",
        "Validates the YAML in strict mode before running anything",
        "No built-in scheduler: install translates the cron to launchd"
      ]
    },
    {
      "dot": "emerald",
      "title": "Data repo",
      "items": [
        "One directory per pipeline, with its pipeline.yaml",
        "Prompts in steps/, agents in agents/, channel in scripts/",
        ".runs/, .env and .params.local.json are never committed"
      ]
    },
    {
      "dot": "rose",
      "title": "Outside both repos",
      "items": [
        "launchd plists in ~/Library/LaunchAgents",
        "Workspaces: own clones, forced to origin/main",
        "Retiring an old cron job is manual: launchctl disable"
      ]
    }
  ]
