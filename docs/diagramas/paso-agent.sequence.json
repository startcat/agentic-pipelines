      "label": "FS guard",
      "sublabel": "hook PreToolUse"
    },
    {
      "id": "workspace",
      "type": "database",
      "label": "Workspace",
      "sublabel": "step cwd"
    },
    {
      "id": "mcp",
      "type": "external",
      "label": "MCP server",
      "sublabel": "stdio"
    },
    {
      "id": "runs",
      "type": "database",
      "label": ".runs/",
      "sublabel": "StepRecord + log"
    }
  ],
