{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Anatomy of an agent step",
    "output": "paso-agent.html",
    "viewBox": [
      1080,
      620
    ],
    "quality_profile": "showcase",
    "column_fit": "spread",
    "views": [
      {
        "id": "preparacion",
        "label": "Preparation",
        "focus": [
          "runner",
          "repo",
          "sdk"
        ],
        "note": "The runner builds the prompt and opens the session with a closed list of tools."
      },
      {
        "id": "gobierno",
        "label": "Governed session",
        "focus": [
          "sdk",
          "guard",
          "workspace",
          "mcp"
        ],
        "note": "Every tool goes through the guard before it runs; writing outside cwd is denied."
      },
      {
        "id": "cierre",
        "label": "Close",
        "focus": [
          "sdk",
          "runner",
          "runs"
        ],
        "note": "Outputs are validated against the contract and everything is kept in .runs/."
      }
    ]
  },
  "participants": [
    {
      "id": "runner",
      "type": "backend",
      "label": "Runner",
      "sublabel": "runAgentStep"
    },
    {
      "id": "repo",
      "type": "database",
      "label": "Data repo",
      "sublabel": "agents/ · steps/"
    },
    {
      "id": "sdk",
      "type": "backend",
      "label": "Claude Agent SDK",
      "sublabel": "query()"
    },
    {
      "id": "guard",
